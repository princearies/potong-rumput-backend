{
  "name": "potong-rumput-backend",
  "version": "1.0.0",
  "description": "On-Demand Lawn Mowing / Handyman Marketplace API built with Hono Framework and Cloudflare D1",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute potong-rumput-db --local --file schema.sql",
    "db:migrate": "wrangler d1 migrations apply potong-rumput-db --local",
    "db:reset": "wrangler d1 reset potong-rumput-db --local",
    "db:seed": "node scripts/seed.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.88.0"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "cloudflare-workers",
    "hono",
    "d1",
    "telegram",
    "lawn-mowing",
    "handyman"
  ],
  "author": "DeepSeek Harness",
  "license": "MIT"
}